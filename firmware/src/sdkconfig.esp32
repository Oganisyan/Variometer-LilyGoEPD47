# ESP-IDF 5.5 SDK Configuration for ESP32
# This file is auto-generated. Use 'idf.py menuconfig' to modify.

CONFIG_IDF_TARGET="esp32"
CONFIG_ESP_REV_MIN_FULL=0x00
CONFIG_ESP_REV_MAX_FULL=0xffff

# Serial Flasher Config
CONFIG_ESPTOOLPY_BAUD=115200
CONFIG_ESPTOOLPY_CHIP="esp32"
CONFIG_ESPTOOLPY_BEFORE="default_reset"
CONFIG_ESPTOOLPY_AFTER="hard_reset"
CONFIG_ESPTOOLPY_FLASH_MODE="dio"
CONFIG_ESPTOOLPY_FLASH_FREQ="40m"
CONFIG_ESPTOOLPY_FLASH_SIZE="detect"

# Partition Table
CONFIG_PARTITION_TABLE_TYPE="default"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_PARTITION_TABLE_MD5=y

# Bootloader
CONFIG_BOOTLOADER_OFFSET_IN_FLASH=0x1000
CONFIG_BOOTLOADER_VDDIO_GPIO=GPIO16
CONFIG_BOOTLOADER_WDT_ENABLE=y
CONFIG_BOOTLOADER_WDT_TIME_MS=9000

# Compiler Settings
CONFIG_COMPILER_OPTIMIZATION_DEFAULT=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=n
CONFIG_COMPILER_OPTIMIZATION_PERF=n
CONFIG_COMPILER_OPTIMIZATION_DEBUG=n
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_ENABLE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTION_LEVEL=2

# C++ Standard
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_CXX_RTTI=y
CONFIG_COMPILER_C_STANDARD="c17"
CONFIG_COMPILER_CXX_STANDARD="c++17"

# Memory
CONFIG_ESP32_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_TYPE=auto
CONFIG_SPIRAM_SIZE=-1
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=8192
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=16384
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# FreeRTOS
CONFIG_FREERTOS_UNICORE=n
CONFIG_FREERTOS_TICK_RATE_HZ=1000
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_MAX_TASK_NAME_LEN=16
CONFIG_FREERTOS_ENABLE_STATIC_TASK_CLEAN_UP=n
CONFIG_FREERTOS_SUPPORT_STATIC_ALLOCATION=y
CONFIG_FREERTOS_SUPPORT_DYNAMIC_ALLOCATION=y
CONFIG_FREERTOS_TASK_FUNCTION_WRAPPER=y

# Logging
CONFIG_LOG_DEFAULT_LEVEL=3
CONFIG_LOG_DEFAULT_LEVEL_EMERG=y
CONFIG_LOG_DEFAULT_LEVEL_ALERT=n
CONFIG_LOG_DEFAULT_LEVEL_CRIT=n
CONFIG_LOG_DEFAULT_LEVEL_ERROR=n
CONFIG_LOG_DEFAULT_LEVEL_WARN=n
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL_DEBUG=n
CONFIG_LOG_DEFAULT_LEVEL_VERBOSE=n

# WiFi
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_TX_BUFFER_TYPE=0
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y

# I2C
CONFIG_I2C_ENABLE_STATUS_DEBUG_INFO=n

# GPIO
CONFIG_GPIO_CTRL_FUNC_IN_IRAM=n

# ADC
CONFIG_ADC_FORCE_XPD_CTRL=n

# UART
CONFIG_UART_ISR_IN_IRAM=n

# SPI
CONFIG_SPI_MASTER_IN_IRAM=n
CONFIG_SPI_MASTER_ISR_IN_IRAM=n
CONFIG_SPI_SLAVE_ISR_IN_IRAM=n

# FATFS
CONFIG_FATFS_CODEPAGE_DYNAMIC=n
CONFIG_FATFS_USE_MUTEX=y
CONFIG_FATFS_ALLOC_PREFER_EXTRAM=y

# NVS
CONFIG_NVS_ENCRYPTION=n

# Security
CONFIG_SECURE_BOOT=n
CONFIG_SECURE_FLASH_ENC_ENABLED=n

# Performance
CONFIG_PERFORMANCE_LEVEL_MEDIUM=y
