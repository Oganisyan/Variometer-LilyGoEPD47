# ESP-IDF 5.5 SDK Configuration for ESP32-S3
# For FREENOVE CYD compatibility

CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_REV_MIN_FULL=0x00
CONFIG_ESP_REV_MAX_FULL=0xffff

# Serial Flasher Config
CONFIG_ESPTOOLPY_BAUD=115200
CONFIG_ESPTOOLPY_CHIP="esp32s3"
CONFIG_ESPTOOLPY_BEFORE="default_reset"
CONFIG_ESPTOOLPY_AFTER="hard_reset"
CONFIG_ESPTOOLPY_FLASH_MODE="dio"
CONFIG_ESPTOOLPY_FLASH_FREQ="80m"
CONFIG_ESPTOOLPY_FLASH_SIZE="16MB"

# Partition Table
CONFIG_PARTITION_TABLE_TYPE="default"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_PARTITION_TABLE_MD5=y

# Bootloader
CONFIG_BOOTLOADER_OFFSET_IN_FLASH=0x0
CONFIG_BOOTLOADER_SPI_SAVE_OPTIMIZATION=y

# Compiler Settings
CONFIG_COMPILER_OPTIMIZATION_DEFAULT=y
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_CXX_RTTI=y
CONFIG_COMPILER_C_STANDARD="c17"
CONFIG_COMPILER_CXX_STANDARD="c++17"

# USB OTG/Serial
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG_RX_ONLY=n

# PSRAM
CONFIG_ESP32S3_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_TYPE=auto
CONFIG_SPIRAM_SIZE=-1
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=8192

# FreeRTOS
CONFIG_FREERTOS_UNICORE=n
CONFIG_FREERTOS_TICK_RATE_HZ=1000
CONFIG_FREERTOS_MAX_TASK_NAME_LEN=16
CONFIG_FREERTOS_SUPPORT_STATIC_ALLOCATION=y
CONFIG_FREERTOS_SUPPORT_DYNAMIC_ALLOCATION=y

# Logging
CONFIG_LOG_DEFAULT_LEVEL=3

# WiFi
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y

# Performance
CONFIG_PERFORMANCE_LEVEL_MEDIUM=y
